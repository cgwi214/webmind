# =====================
# Application
# =====================
APP_NAME=WebMind
ENV=development
DEBUG=true

# =====================
# Backend
# =====================
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# =====================
# LLM配置
# =====================
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-xxxxxx
OPENAI_BASE_URL=https://api.openai.com/v1
MODEL_NAME=gpt-4.1
LLM_MOCK_MODE=auto
LLM_TIMEOUT=120

# 可选：配置多模态模型后，视觉评估会切换到模型打分通道（留空则走结构化比对）
VISION_MODEL=

# =====================
# MySQL
# =====================
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=webmind
MYSQL_USER=root
MYSQL_PASSWORD=password

# =====================
# MongoDB
# =====================
MONGO_HOST=mongodb
MONGO_PORT=27017
MONGO_DATABASE=webmind
MONGO_URL=mongodb://mongodb:27017

# =====================
# Redis
# =====================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://redis:6379

# =====================
# 降级策略
# =====================
DB_BACKEND=auto
DOC_STORE_BACKEND=auto
CACHE_BACKEND=auto
SQLITE_PATH=./data/webmind.db

# =====================
# LangGraph
# =====================
LANGGRAPH_CHECKPOINT=true
MAX_SELF_REPAIR=2

# =====================
# 文件存储
# （本地开发用相对路径；docker-compose 会用容器内绝对路径覆盖）
# =====================
UPLOAD_DIR=./data/uploads
CODE_OUTPUT_DIR=./data/generated_code

# =====================
# 评估体系
# =====================
EVALUATION_ENABLED=true
EVALUATION_DATASET_DIR=./evaluation_dataset
EVALUATION_OUTPUT_DIR=./data/evaluation
EVAL_HARD_GATE=true
WEIGHT_CODE=0.30
WEIGHT_VISUAL=0.25
WEIGHT_REQUIREMENT=0.20
WEIGHT_AGENT=0.15
WEIGHT_ENGINEERING=0.10
VISUAL_MODEL_WEIGHT=0.7
VISUAL_HUMAN_WEIGHT=0.3
